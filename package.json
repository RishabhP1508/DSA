{
  "name": "dsa",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "verify:lessons": "node --experimental-strip-types --import ./scripts/lib/ts-register.mjs scripts/verify_lessons.mjs",
    "verify:patterns": "node --experimental-strip-types --import ./scripts/lib/ts-register.mjs scripts/verify_patterns.mjs",
    "verify:complexity": "node --experimental-strip-types --import ./scripts/lib/ts-register.mjs scripts/verify_complexity.mjs",
    "verify:visualizers": "node scripts/verify_visualizers.mjs",
    "verify:pipeline": "node scripts/verify_pipeline.mjs",
    "verify:exercises": "node --experimental-strip-types --import ./scripts/lib/ts-register.mjs scripts/verify_exercise_tests.mjs",
    "verify:line-explanations": "node --experimental-strip-types --import ./scripts/lib/ts-register.mjs scripts/verify_line_explanations.mjs",
    "verify:example-model": "node --experimental-strip-types --import ./scripts/lib/ts-register.mjs scripts/verify_example_model.mjs",
    "gen:coverage": "node --experimental-strip-types --import ./scripts/lib/ts-register.mjs scripts/gen_coverage_md.mjs",
    "test:unit": "vitest run",
    "test:unit:watch": "vitest",
    "test:browser": "playwright test",
    "test:python": "node scripts/verify_pipeline.mjs && node scripts/verify_visualizers.mjs",
    "test:curriculum": "npm run verify:lessons && npm run verify:patterns && npm run verify:complexity && npm run verify:line-explanations && npm run verify:example-model",
    "test:exercises": "npm run verify:exercises",
    "check:all": "npm run build && npm run lint && npm run test:unit && npm run test:python && npm run test:curriculum && npm run test:exercises"
  },
  "dependencies": {
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-python": "^6.2.1",
    "@codemirror/state": "^6.7.5",
    "@codemirror/view": "^6.43.12",
    "codemirror": "^6.0.2",
    "idb": "^8.0.3",
    "pyodide": "^314.0.7",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/coverage-v8": "^3.2.7",
    "fake-indexeddb": "^6.2.5",
    "fast-check": "^3.23.2",
    "jsdom": "^25.0.1",
    "oxlint": "^1.81.0",
    "typescript": "~6.0.2",
    "vite": "^8.3.0",
    "vitest": "^3.2.7"
  }
}
